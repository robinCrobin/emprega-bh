# Exemplo local. Execute python scripts/setup_env.py para gerar uma senha.
POSTGRES_DB=empregabh
POSTGRES_USER=empregabh
POSTGRES_PASSWORD=
DB_PORT=5433
API_PORT=8000
WEB_PORT=5173
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# O navegador acessa a API via proxy do Vite. Nao usar http://api:8000 no navegador.
VITE_API_BASE_URL=/api
# Historico minimo (trimestres com dados) para gerar previsao e tendencia. Padrao: 8.
MIN_TRIMESTRES_PREVISAO=8
# Maximo de resultados da busca de ocupacoes.
BUSCA_LIMITE_MAXIMO=50
